#!/bin/sh
# claude-local: run Claude Code against a local Ollama model.
#
# Starts the shim proxy if it isn't running, then execs Claude Code with the
# right env. Shell-agnostic (bash/zsh/fish). Extra args pass straight to claude.
#
#   claude-local                     # claude with defaults (Ollama + shim)
#   claude-local --resume            # any claude flag
#   claude-local --vllm              # tested NVFP4 + DFlash2 on :8000, thinking off
#   claude-local --vllm --think on   # enable thinking through the passthrough shim
#   claude-local --sglang            # SGLang server on :30000, no shim
#   claude-local --sglang=http://host:port  # SGLang/Anthropic-compatible server elsewhere
#   claude-local --freetoken         # FreeToken engine on :1919, no shim
#   claude-local --freetoken=http://host:port
#   claude-local --hybrid            # main 27B on SGLang + small 1-bit on Ollama (routing shim)
#
# --sglang and --freetoken work with any server that speaks the Anthropic
# Messages API natively (SGLang and FreeToken both ship /v1/messages). No shim
# runs in those modes: the shim only exists to work around Ollama's
# mid-conversation system-message bug.
#
# Env (all optional):
#   CLAUDE_LOCAL_MODEL        model name for ANTHROPIC_MODEL  (default: first model in `ollama list`,
#                             or first id in /v1/models with --sglang)
#   CLAUDE_LOCAL_SHIM_PORT    shim listen port                (default: 11500)
#   CLAUDE_LOCAL_OLLAMA_URL   Ollama upstream                 (default: http://localhost:11434)
#   CLAUDE_LOCAL_SHIM_BIN     python interpreter for the shim (default: python3)
#   CLAUDE_LOCAL_SHIM         explicit shim.py path   (default: <script dir>/shim.py)
#   CLAUDE_LOCAL_NO_AUTOSTART skip auto-starting the shim     (default: 0)
#   CLAUDE_LOCAL_SMALL_MODEL  small/haiku model for --hybrid  (default: the 1-bit 27B in Ollama)
#   CLAUDE_LOCAL_HYBRID_PORT  routing-shim port for --hybrid  (default: 11501)
#   CLAUDE_LOCAL_SGLANG_BASE  SGLang URL for --hybrid         (default: http://localhost:30000)
#   CLAUDE_LOCAL_FREETOKEN_BASE  FreeToken URL for --freetoken (default: http://127.0.0.1:1919)
#   CLAUDE_LOCAL_FREETOKEN_START command that brings FreeToken up (default: freetoken-serve start)
#   CLAUDE_LOCAL_THINK        default for --think (off|on; unset = leave alone)
#   CLAUDE_LOCAL_THINK_PORT   port for the --think shim   (default: 11502)
#   FREETOKEN_PORT / FREETOKEN_MODEL / FREETOKEN_FT_BIN  freetoken-serve knobs (see that script)
set -u

# Resolve this script's directory (follows symlinks where possible).
src="$0"
while [ -h "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT=$(cd "$(dirname "$src")" && pwd)
SHIM="${CLAUDE_LOCAL_SHIM:-$ROOT/shim.py}"

# Launcher-owned flags must come before claude's own args.
DIRECT_URL=""
DIRECT_PROVIDER=""
HYBRID=0
# off|on: rewrite the thinking mode Claude Code sends (it always says
# "adaptive", which local servers ignore -> the checkpoint's own default wins).
THINK="${CLAUDE_LOCAL_THINK:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --vllm)         DIRECT_URL="${CLAUDE_LOCAL_VLLM_BASE:-http://127.0.0.1:8000}"; DIRECT_PROVIDER="vllm"; shift ;;
    --vllm=*)       DIRECT_URL="${1#--vllm=}"; DIRECT_PROVIDER="vllm"; shift ;;
    --sglang)        DIRECT_URL="http://localhost:30000"; DIRECT_PROVIDER="sglang"; shift ;;
    --sglang=*)      DIRECT_URL="${1#--sglang=}"; DIRECT_PROVIDER="sglang"; shift ;;
    --freetoken)     DIRECT_URL="${CLAUDE_LOCAL_FREETOKEN_BASE:-http://127.0.0.1:1919}"; DIRECT_PROVIDER="freetoken"; shift ;;
    --freetoken=*)   DIRECT_URL="${1#--freetoken=}"; DIRECT_PROVIDER="freetoken"; shift ;;
    --hybrid)        HYBRID=1; shift ;;
    --think)         THINK="${2:?--think needs off|on}"; shift 2 ;;
    --think=*)       THINK="${1#--think=}"; shift ;;
    --no-think)      THINK="off"; shift ;;
    *) break ;;
  esac
done

if [ "$DIRECT_PROVIDER" = "vllm" ]; then
  THINK="${THINK:-off}"
  export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-8192}"
fi

PORT="${CLAUDE_LOCAL_SHIM_PORT:-11500}"
OLLAMA_URL="${CLAUDE_LOCAL_OLLAMA_URL:-http://localhost:11434}"
PY="${CLAUDE_LOCAL_SHIM_BIN:-python3}"

# Hybrid-mode settings (--hybrid): main 27B on SGLang, small 1-bit on Ollama.
SGLANG_BASE="${CLAUDE_LOCAL_SGLANG_BASE:-http://localhost:30000}"
HYBRID_PORT="${CLAUDE_LOCAL_HYBRID_PORT:-11501}"
SMALL_MODEL="${CLAUDE_LOCAL_SMALL_MODEL:-hf.co/unsloth/Qwen3.8-27B-GGUF:UD-IQ1_M}"

RUN="${XDG_RUNTIME_DIR:-/tmp}/claude-local"
mkdir -p "$RUN"

# Is a server answering at <url>/v1/models?
url_up() { curl -sf -m 2 "$1/v1/models" >/dev/null 2>&1; }

# stale_shim <url> <name> <cfg>: a shim we started earlier keeps whatever
# settings it was launched with, so `--think off` after `--think on` (or a
# hybrid run with another SGLang URL) would silently reuse the wrong one.
# Each launch records its settings in $RUN/shim-<name>.cfg; if a shim is up
# and the record differs, stop it so the caller starts a fresh one.
stale_shim() {
  url_up "$1" || return 0
  [ "$(cat "$RUN/shim-$2.cfg" 2>/dev/null)" = "$3" ] && return 0
  echo "claude-local: $2 shim at $1 was started with other settings; restarting it" >&2
  kill "$(cat "$RUN/shim-$2.pid" 2>/dev/null)" 2>/dev/null
  i=0
  while [ $i -lt 20 ] && url_up "$1"; do i=$((i + 1)); sleep 0.25; done
  url_up "$1" && echo "claude-local: could not stop it (not ours?); reusing as-is" >&2
  return 0
}

# Bring SGLang up if it is down (honors CLAUDE_LOCAL_NO_AUTOSTART).
sglang_autostart() {
  url_up "$SGLANG_BASE" && return 0
  starter="${CLAUDE_LOCAL_SGLANG_START:-}"
  if [ -z "$starter" ] && [ "$SGLANG_BASE" = "http://localhost:30000" ] \
      && command -v sglang-serve >/dev/null 2>&1; then
    starter="sglang-serve start"
  fi
  if [ -n "$starter" ] && [ "${CLAUDE_LOCAL_NO_AUTOSTART:-0}" != "1" ]; then
    echo "claude-local: SGLang at $SGLANG_BASE is down; running: $starter" >&2
    echo "claude-local: (model load can take minutes on a cold start)" >&2
    $starter >&2 || return 1
  fi
  url_up "$SGLANG_BASE"
}

# ---- Hybrid mode: main 27B on SGLang + small 1-bit on Ollama ----
# One base URL (the routing shim, on its own port) serves both; the shim
# splits by the request's model name. A dedicated port keeps it from
# colliding with the plain Ollama shim. This branch execs or exits, so it
# never falls through to the modes below.
if [ "$HYBRID" = "1" ]; then
  HBASE="http://127.0.0.1:$HYBRID_PORT"

  [ -f "$SHIM" ] || { echo "claude-local: shim not found at $SHIM" >&2; exit 1; }
  sglang_autostart || { echo "claude-local: no SGLang server answering at $SGLANG_BASE" >&2; exit 1; }

  # Main model = whatever SGLang serves.
  if [ -z "${CLAUDE_LOCAL_MODEL:-}" ]; then
    CLAUDE_LOCAL_MODEL=$(curl -sf -m 2 "$SGLANG_BASE/v1/models" \
      | grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
      | sed 's/.*"\([^"]*\)"$/\1/')
    [ -n "$CLAUDE_LOCAL_MODEL" ] || { echo "claude-local: no model id from $SGLANG_BASE; set CLAUDE_LOCAL_MODEL" >&2; exit 1; }
  fi

  # Start the routing shim if it is not already up on its port. A running
  # shim started with other settings is restarted (see stale_shim).
  if [ "${CLAUDE_LOCAL_NO_AUTOSTART:-0}" != "1" ]; then
    stale_shim "$HBASE" hybrid "$SGLANG_BASE $OLLAMA_URL $CLAUDE_LOCAL_MODEL"
  fi
  if [ "${CLAUDE_LOCAL_NO_AUTOSTART:-0}" != "1" ] && ! url_up "$HBASE"; then
    echo "claude-local: starting routing shim on $HBASE (sglang=$SGLANG_BASE ollama=$OLLAMA_URL)" >&2
    HLOG="$RUN/shim-hybrid.log"
    CLAUDE_LOCAL_SHIM_PORT="$HYBRID_PORT" CLAUDE_LOCAL_OLLAMA_URL="$OLLAMA_URL" \
    CLAUDE_LOCAL_SGLANG_URL="$SGLANG_BASE" CLAUDE_LOCAL_SGLANG_MODELS="$CLAUDE_LOCAL_MODEL" \
      nohup "$PY" "$SHIM" >>"$HLOG" 2>&1 &
    echo $! > "$RUN/shim-hybrid.pid"
    echo "$SGLANG_BASE $OLLAMA_URL $CLAUDE_LOCAL_MODEL" > "$RUN/shim-hybrid.cfg"
    i=0
    while [ $i -lt 60 ]; do url_up "$HBASE" && break; i=$((i + 1)); sleep 0.5; done
    url_up "$HBASE" || { echo "claude-local: hybrid shim failed to start; see $HLOG" >&2; exit 1; }
  fi

  echo "claude-local: hybrid — main='$CLAUDE_LOCAL_MODEL' (SGLang) small='$SMALL_MODEL' (Ollama)" >&2
  exec env \
    ANTHROPIC_BASE_URL="$HBASE" \
    ANTHROPIC_MODEL="$CLAUDE_LOCAL_MODEL" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$SMALL_MODEL" \
    claude "$@"
fi

if [ -n "$DIRECT_URL" ]; then
  # Direct mode: the upstream speaks the Anthropic Messages API itself.
  BASE="${DIRECT_URL%/}"
  # FreeToken answers /v1/models (200) while weights are still loading and
  # the first real request 503s; only /health {"status":"ok"} means ready.
  server_up() {
    case "$DIRECT_PROVIDER" in
      freetoken) curl -sf -m 2 "$BASE/health" 2>/dev/null \
                   | grep -q '"status"[[:space:]]*:[[:space:]]*"ok"' ;;
      *)         url_up "$BASE" ;;
    esac
  }
  if ! server_up; then
    # Autostart: a <PROVIDER>_START env names a command that starts the server
    # and returns once it is healthy. If unset, the matching *-serve script on
    # PATH is used. Disabled by CLAUDE_LOCAL_NO_AUTOSTART=1.
    case "$DIRECT_PROVIDER" in
      vllm)
        starter="${CLAUDE_LOCAL_VLLM_START:-}"
        if [ -z "$starter" ] && [ "$BASE" = "http://127.0.0.1:8000" ] \
            && command -v vllm-serve >/dev/null 2>&1; then
          starter="vllm-serve start"
        fi ;;
      freetoken)
        starter="${CLAUDE_LOCAL_FREETOKEN_START:-}"
        # Only manage the default local port; don't "fix" an unreachable custom
        # URL by starting a server elsewhere.
        if [ -z "$starter" ] && [ "$BASE" = "http://127.0.0.1:1919" ] \
            && command -v freetoken-serve >/dev/null 2>&1; then
          starter="freetoken-serve start"
        fi ;;
      *)
        starter="${CLAUDE_LOCAL_SGLANG_START:-}"
        if [ -z "$starter" ] && [ "$BASE" = "http://localhost:30000" ] \
            && command -v sglang-serve >/dev/null 2>&1; then
          starter="sglang-serve start"
        fi ;;
    esac
    if [ -n "$starter" ] && [ "${CLAUDE_LOCAL_NO_AUTOSTART:-0}" != "1" ]; then
      echo "claude-local: server at $BASE is down; running: $starter" >&2
      echo "claude-local: (model load can take minutes on a cold start)" >&2
      $starter >&2 || { echo "claude-local: start command failed." >&2; exit 1; }
    fi
    if ! server_up; then
      echo "claude-local: no server answering at $BASE" >&2
      case "$DIRECT_PROVIDER" in
        freetoken) echo "claude-local: start one first (e.g. freetoken-serve start)." >&2 ;;
        *)         echo "claude-local: start one first (e.g. an SGLang server on that port)." >&2 ;;
      esac
      exit 1
    fi
  fi
  if [ -z "${CLAUDE_LOCAL_MODEL:-}" ]; then
    CLAUDE_LOCAL_MODEL=$(curl -sf -m 2 "$BASE/v1/models" \
      | grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
      | sed 's/.*"\([^"]*\)"$/\1/')
    if [ -z "$CLAUDE_LOCAL_MODEL" ]; then
      echo "claude-local: could not read a model id from $BASE/v1/models; set CLAUDE_LOCAL_MODEL." >&2
      exit 1
    fi
    echo "claude-local: using model '$CLAUDE_LOCAL_MODEL' from $BASE (set CLAUDE_LOCAL_MODEL to override)" >&2
  fi

  # --think needs a field Claude Code won't send, so put the shim in front as a
  # native passthrough that rewrites it. Without --think, stay truly direct.
  if [ -n "$THINK" ]; then
    case "$THINK" in
      off|on) ;;
      *) echo "claude-local: --think takes 'off' or 'on' (got '$THINK')" >&2; exit 1 ;;
    esac
    [ -f "$SHIM" ] || { echo "claude-local: shim not found at $SHIM" >&2; exit 1; }
    default_think_port=11502
    [ "$DIRECT_PROVIDER" = "vllm" ] && default_think_port=11503
    THINK_PORT="${CLAUDE_LOCAL_THINK_PORT:-$default_think_port}"
    UPSTREAM_BASE="$BASE"
    BASE="http://127.0.0.1:$THINK_PORT"
    stale_shim "$BASE" think "$THINK $UPSTREAM_BASE $DIRECT_PROVIDER"
    if ! url_up "$BASE"; then
      echo "claude-local: thinking=$THINK — shim on :$THINK_PORT -> $UPSTREAM_BASE" >&2
      CLAUDE_LOCAL_SHIM_PORT="$THINK_PORT" CLAUDE_LOCAL_OLLAMA_URL="$UPSTREAM_BASE" \
        CLAUDE_LOCAL_NATIVE=1 CLAUDE_LOCAL_THINKING="$THINK" CLAUDE_LOCAL_THINK_PROVIDER="$DIRECT_PROVIDER" \
        nohup "$PY" "$SHIM" >>"$RUN/shim-think.log" 2>&1 &
      echo $! > "$RUN/shim-think.pid"
      echo "$THINK $UPSTREAM_BASE $DIRECT_PROVIDER" > "$RUN/shim-think.cfg"
      i=0
      while [ $i -lt 40 ]; do
        url_up "$BASE" && break
        i=$((i + 1)); sleep 0.25
      done
      [ $i -lt 40 ] || { echo "claude-local: shim failed to start; see $RUN/shim-think.log" >&2; exit 1; }
    fi
  fi
else
  BASE="http://127.0.0.1:$PORT"

  [ -f "$SHIM" ] || { echo "claude-local: shim not found at $SHIM" >&2; exit 1; }

  # Pick a model if the user didn't name one.
  if [ -z "${CLAUDE_LOCAL_MODEL:-}" ]; then
    if command -v ollama >/dev/null 2>&1; then
      CLAUDE_LOCAL_MODEL=$(ollama list 2>/dev/null | awk 'NR>1 && $4 ~ /GB|MB|B$/ {print $1; exit}')
    fi
    CLAUDE_LOCAL_MODEL="${CLAUDE_LOCAL_MODEL:-}"
    if [ -z "$CLAUDE_LOCAL_MODEL" ]; then
      echo "claude-local: no model set and none found via 'ollama list'." >&2
      echo "claude-local: pull one (ollama pull qwen2.5-coder:14b) or set CLAUDE_LOCAL_MODEL." >&2
      exit 1
    fi
    echo "claude-local: using model '$CLAUDE_LOCAL_MODEL' (set CLAUDE_LOCAL_MODEL to override)" >&2
  fi

  # Is the shim already answering?
  shim_up() {
    curl -sf -m 2 "$BASE/v1/models" >/dev/null 2>&1
  }

  if [ "${CLAUDE_LOCAL_NO_AUTOSTART:-0}" = "1" ]; then
    shim_up || { echo "claude-local: shim not running on $BASE (autostart disabled)." >&2; exit 1; }
  else
    if ! shim_up; then
      echo "claude-local: starting shim on 127.0.0.1:$PORT -> $OLLAMA_URL" >&2
      LOG="$RUN/shim.log"
      CLAUDE_LOCAL_SHIM_PORT="$PORT" CLAUDE_LOCAL_OLLAMA_URL="$OLLAMA_URL" \
        nohup "$PY" "$SHIM" >>"$LOG" 2>&1 &
      echo $! > "$RUN/shim.pid"
      # Ollama may be under load; be generous: ~30s budget, 2s per attempt.
      started=0
      i=0
      while [ $i -lt 60 ]; do
        if shim_up; then started=1; break; fi
        i=$((i + 1))
        sleep 0.5
      done
      [ "$started" = 1 ] || { echo "claude-local: shim failed to start; see $LOG" >&2; exit 1; }
    fi
  fi
fi

# Sanity-check the upstream actually has the model (warn, don't hard-fail).
if ! curl -sf -m 2 "$BASE/v1/models" 2>/dev/null | grep -q "\"$CLAUDE_LOCAL_MODEL\""; then
  echo "claude-local: note: '$CLAUDE_LOCAL_MODEL' not visible in $BASE/v1/models yet." >&2
fi

# Claude Code doesn't recognize local model names, so it assumes a 200k window
# and auto-compacts early. Tell it the real one if /v1/models advertises it.
server_context=$(curl -sf -m 2 "$BASE/v1/models" 2>/dev/null \
  | grep -o '"max_model_len"[[:space:]]*:[[:space:]]*[0-9]*' | head -1 \
  | grep -o '[0-9]*$')
if [ -n "$server_context" ]; then
  if [ -z "${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-}" ] || \
      [ "$CLAUDE_CODE_MAX_CONTEXT_TOKENS" -gt "$server_context" ] 2>/dev/null; then
    CLAUDE_CODE_MAX_CONTEXT_TOKENS="$server_context"
  fi
fi

exec env \
  ${CLAUDE_CODE_MAX_CONTEXT_TOKENS:+CLAUDE_CODE_MAX_CONTEXT_TOKENS="$CLAUDE_CODE_MAX_CONTEXT_TOKENS"} \
  ANTHROPIC_BASE_URL="$BASE" \
  ANTHROPIC_MODEL="$CLAUDE_LOCAL_MODEL" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$CLAUDE_LOCAL_MODEL" \
  claude "$@"
